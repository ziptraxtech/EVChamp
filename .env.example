# Copy this to .env.local and fill in your actual values
# .env.local is in .gitignore and will NEVER be committed

# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
ZEFLASH_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Clerk Auth
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Firebase
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Email
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# APIs
ZEFLASH_BACKEND_URL=https://zeflash-backend.com
ZEFLASH_PARTNER_API_KEY=xxxxx
ZIPSUREAI_PARTNER_API_KEY=xxxxx
CRON_SECRET=xxxxx